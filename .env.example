NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only; never expose to client

CRON_SECRET=   # random secret string; set in Vercel env vars too; sent as Authorization: Bearer header by Vercel Cron

GEMINI_API_KEY=   # server-only; used by /api/extract-job for JD paste-to-autofill (Google AI Studio)

# Optional: external capture endpoint (docs/daypilot/capture-endpoint.md). Leave both empty to disable it.
PLANNER_CAPTURE_TOKEN=   # server-only; at least 32 random characters: openssl rand -base64 32
PLANNER_CAPTURE_USER_ID=   # server-only; your auth.users id; the only account this endpoint can write to
